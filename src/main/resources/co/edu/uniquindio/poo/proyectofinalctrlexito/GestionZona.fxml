<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.GestionZonaViewController">
   <children>
      <Label text="GESTIÓN DE LOCALIDADES Y ZONAS" textFill="#2D3748">
         <font><Font name="System Bold" size="24.0" /></font>
      </Label>
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="280.0" spacing="12.0" style="-fx-background-color: #F7FAFC; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E2E8F0;">
               <children>
                  <TextField fx:id="txtNombreZona" prefHeight="35.0" promptText="Nombre Zona " />
                  <TextField fx:id="txtPrecioBase" prefHeight="35.0" promptText="Precio Base de Entrada ($)" />
                  <Button fx:id="btnAgregarZona" maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-color: #3182CE; -fx-text-fill: white;" text="Guardar Zona" />
               </children>
            </VBox>
            <TableView fx:id="tablaZonas" style="-fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold;" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
</VBox>
