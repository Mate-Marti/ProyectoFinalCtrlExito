<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.ZonaViewController">
    <children>
        <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
            <children>
                <Label text="DETALLES DE LA ZONA SELECCIONADA" textFill="#d16666">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
                <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2222; -fx-padding: 20; -fx-background-radius: 8;">
                    <children>
                        <Label fx:id="lblNombreZona" style="-fx-font-size: 16;" text="Zona: -" />
                        <Label fx:id="lblPrecio" style="-fx-font-size: 16;" text="Precio Base: $0.00" />
                    </children>
                </VBox>
                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volver" prefHeight="38.0" prefWidth="100.0" text="Volver" />
            </children>
        </VBox>
    </children>
</AnchorPane>
