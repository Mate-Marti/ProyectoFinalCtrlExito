<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="950.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.MetricaViewController">
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="TABLERO DE MÉTRICAS Y RENDIMIENTO" textFill="#2B6CB0">
               <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            <Label text="Estadísticas en tiempo real basadas en los eventos, compras e incidencias" textFill="#718096" />
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #F7FAFC; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E2E8F0;" HBox.hgrow="SOMETIMES">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Ventas de Entradas por Evento" textFill="#2D3748">
                     <font><Font size="14.0" /></font>
                  </Label>
                  <PieChart fx:id="pieChartVentas" legendSide="BOTTOM" title="Distribución de Ingresos" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #F7FAFC; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E2E8F0;" HBox.hgrow="SOMETIMES">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Estado de Incidencias" textFill="#2D3748">
                     <font><Font size="14.0" /></font>
                  </Label>
                  <PieChart fx:id="pieChartIncidencias" legendSide="BOTTOM" title="Proporción por Estado" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_RIGHT" prefHeight="40.0" spacing="15.0">
         <children>
            <Button fx:id="btnDescargarPDF" onAction="#descargarPDF" prefHeight="38.0" prefWidth="200.0" style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="📄 Descargar Reporte PDF" />

            <Button fx:id="btnActualizarMetricas" onAction="#actualizarDatos" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Actualizar Datos" />

            <Region prefWidth="10.0" />

            <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #CBD5E0; -fx-border-radius: 8;" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
</VBox>