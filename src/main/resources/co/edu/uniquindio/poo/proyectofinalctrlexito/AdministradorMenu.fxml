<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.AdministradorMenuViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label fx:id="lblTituloUsuarioMenu" text="PANEL GENERAL DE CONTROL" textFill="#2D3748">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label fx:id="lblInfo" text="Selecciona el subsistema de datos que deseas auditar o modificar" textFill="#718096" />
            </children>
        </VBox>
        <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button fx:id="btnGestionEvento" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionEvento" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Gestionar Eventos Globales" />
                <Button fx:id="btnGestionUsuario" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionUsuario" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Gestionar Cuentas Clientes" GridPane.columnIndex="1" />
                <Button fx:id="btnGestionZona" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionZona" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Gestionar Zonas de Localidad" GridPane.rowIndex="1" />
                <Button fx:id="btnGestionRecinto" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionRecinto" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Gestionar Complejos / Recintos" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button fx:id="btnGestionarAsientos" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionAsiento" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Habilitar / Bloquear Asientos" GridPane.rowIndex="2" />
                <Button fx:id="btnReportarIncidentes" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirIncidenciaAdmin" style="-fx-background-color: #FFF5F5; -fx-border-color: #FEB2B2; -fx-text-fill: #9B2C2C; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Ver Reportes de Incidentes " GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Button fx:id="btnGestionCompra" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirGestionCompra" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Gestionar las Compras" GridPane.rowIndex="2" />
                <Button fx:id="btnVerMetricas" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirMetrica" style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text=" Ver Metricas " GridPane.rowIndex="2" />
            </children>
            <padding><Insets bottom="10.0" top="10.0" /></padding>
        </GridPane>
        <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Cerrar Sesión" />
    </children>
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
</VBox>
