<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.ConsultarZonaViewController">

    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>

    <children>

        <Label text="CONSULTAR ZONA" textFill="#2D3748">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <!-- Fila de búsqueda -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <TextField fx:id="txtIdBuscar"
                           prefHeight="38.0" prefWidth="200.0"
                           promptText="ID de la Zona" />
                <Button fx:id="btnBuscar"
                        onAction="#buscarZona"
                        prefHeight="38.0"
                        style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
                        text="Buscar" />
            </children>
        </HBox>

        <!-- Área de resultado -->
        <TextArea fx:id="txtResultado"
                  VBox.vgrow="ALWAYS"
                  editable="false"
                  promptText="La información de la zona aparecerá aquí..."
                  style="-fx-background-color: #F7FAFC; -fx-border-color: #E2E8F0; -fx-background-radius: 8; -fx-font-size: 14;" />

        <HBox alignment="CENTER_LEFT">
            <children>
                <Button fx:id="btnVolver"
                        onAction="#volver"
                        prefHeight="38.0" prefWidth="120.0"
                        mnemonicParsing="false"
                        style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="← Volver" />
            </children>
        </HBox>

    </children>
</VBox>
