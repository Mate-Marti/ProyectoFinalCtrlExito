<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.GestionCompraViewController">
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="AUDITORÍA GENERAL DE COMPRAS" textFill="#2C5282">
               <font><Font name="System Bold" size="26.0" /></font>
            </Label>
            <Label text="Historial de transacciones de boletería del sistema" textFill="#718096" />
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="txtBuscarCompra" prefHeight="35.0" prefWidth="300.0" promptText="Buscar por ID de Compra o Cédula..." style="-fx-background-radius: 6;" />
            <Button fx:id="btnFiltrar" prefHeight="35.0" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Filtrar" />
         </children>
      </HBox>
      <TableView fx:id="tablaMaestraCompras" prefHeight="250.0" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button fx:id="btnAnularCompra" prefHeight="38.0" style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Anular Transacción" />
            <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver" />
         </children>
      </HBox>
   </children>
   <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
</VBox>
