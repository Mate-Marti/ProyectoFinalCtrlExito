<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="500.0" prefWidth="750.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.GestionPerfilViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label text="ACTUALIZAR DATOS PERSONALES" textFill="#2D3748">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label text="información de contacto" textFill="#718096" />
            </children>
        </VBox>
        <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: #F7FAFC; -fx-padding: 25; -fx-background-radius: 10; -fx-border-color: #E2E8F0;">
            <children>
                <TextField fx:id="txtPerfilNombre" prefHeight="38.0" promptText="Nombre Completo" />
                <TextField fx:id="txtPerfilCorreo" prefHeight="38.0" promptText="Correo Electrónico" />
                <TextField fx:id="txtPerfilTelefono" prefHeight="38.0" promptText="Teléfono Celular" />
                <Button fx:id="btnGuardarCambios" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Guardar Información" />
            </children>
        </VBox>
        <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Regresar" />
    </children>
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>
