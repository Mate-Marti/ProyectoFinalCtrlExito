<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="750.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.EventoViewController">
   <children>
      <Label fx:id="lblTituloEvento" text="INFORMACIÓN DE EVENTOS" textFill="#2C5282">
         <font><Font name="System Bold" size="28.0" /></font>
      </Label>
      <Label text="Consulta informacion como fechas, recintos, artistas invitados y restricciones del evento" textFill="#718096" />
      <VBox prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #F7FAFC; -fx-border-color: #E2E8F0; -fx-background-radius: 8;" VBox.vgrow="ALWAYS" />
      <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver" />
   </children>
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>
