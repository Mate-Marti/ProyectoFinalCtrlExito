<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="750.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.IncidenciaAdminViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label text="INCIDENCIAS ENVIADAS" textFill="#9B2C2C">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label text="Administración y soluciones de fallos reportados" textFill="#718096" />
            </children>
        </VBox>
        <VBox maxWidth="650.0" spacing="15.0" style="-fx-background-color: #FFF5F5; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #FEB2B2;">
            <children>
                <TableView fx:id="tablaIncidencias" prefHeight="280.0" prefWidth="600.0" style="-fx-background-radius: 5;">
                    <columns>
                        <TableColumn fx:id="colAsunto" prefWidth="150.0" text="Asunto" />
                        <TableColumn fx:id="colDescripcion" prefWidth="310.0" text="Descripción de la Incidencia" />
                        <TableColumn fx:id="colEstado" prefWidth="144.0" text="Estado Actual" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnSolucionar" onAction="#solucionarIncidencia" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #2F855A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Solucionar Incidencia" />
                        <Button fx:id="btnPosponer" onAction="#posponerIncidencia" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #DD6B20; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Posponer Incidencia" />
                        <Button fx:id="btnVolver" onAction="#volver" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #CBD5E0; -fx-border-radius: 8;" text="Regresar al Menú" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets top="30.0" />
    </padding>
</VBox>