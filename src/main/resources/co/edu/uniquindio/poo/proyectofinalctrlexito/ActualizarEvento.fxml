<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="750.0" spacing="20.0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.ActualizarEventoViewController">

    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

    <children>

        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label text="ACTUALIZAR EVENTO" textFill="#2D3748">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label text="Busca el evento por ID y modifica sus datos" textFill="#718096" />
            </children>
        </VBox>

        <!-- Búsqueda por ID -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <TextField fx:id="txtIdBuscar"
                           prefHeight="38.0" prefWidth="200.0"
                           promptText="ID del Evento" />
                <Button fx:id="btnBuscar"
                        onAction="#buscarEvento"
                        prefHeight="38.0"
                        style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="Buscar" />
            </children>
        </HBox>

        <!-- Datos editables -->
        <VBox prefWidth="400.0" spacing="12.0"
              style="-fx-background-color: #F7FAFC; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #E2E8F0;">
            <children>

                <Label style="-fx-font-weight: bold;" text="Datos del Evento" textFill="#4A5568" />

                <TextField fx:id="txtNombre"
                           prefHeight="38.0"
                           promptText="Nombre del Evento" />

                <TextField fx:id="txtDescripcion"
                           prefHeight="38.0"
                           promptText="Descripción" />

                <TextField fx:id="txtCategoria"
                           prefHeight="38.0"
                           promptText="Categoría" />

                <Button fx:id="btnActualizar"
                        onAction="#actualizarEvento"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="40.0"
                        style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Guardar Cambios" />

            </children>
        </VBox>

        <!-- Cambio de estado -->
        <VBox prefWidth="400.0" spacing="12.0"
              style="-fx-background-color: #FFFBF0; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #F6E05E;">
            <children>

                <Label style="-fx-font-weight: bold;" text="Cambiar Estado del Evento" textFill="#4A5568" />

                <Label fx:id="lblEstadoActual"
                       text="Estado actual: —"
                       textFill="#718096"
                       style="-fx-font-style: italic;" />

                <ComboBox fx:id="comboEstado"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          promptText="Seleccionar nuevo estado" />

                <Button fx:id="btnCambiarEstado"
                        onAction="#cambiarEstado"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="40.0"
                        style="-fx-background-color: #D69E2E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Aplicar Estado" />

            </children>
        </VBox>

        <Button fx:id="btnVolver"
                onAction="#volver"
                prefHeight="38.0" prefWidth="120.0"
                mnemonicParsing="false"
                style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                text="← Volver" />

    </children>
</VBox>
