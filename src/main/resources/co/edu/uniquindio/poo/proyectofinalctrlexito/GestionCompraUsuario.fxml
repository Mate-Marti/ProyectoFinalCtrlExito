<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="750.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.GestionCompraUsuarioViewController">
   <children>
      <Label fx:id="lblTituloCompra" text="HISTORIAL DE TUS COMPRAS" textFill="#2D3748">
         <font><Font name="System Bold" size="28.0" /></font>
      </Label>
      <Label text="Registro de tus reservas y transacciones bancarias procesadas" textFill="#718096" />

      <TableView fx:id="tblCompras" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" prefWidth="120.0" text="ID Compra" />
            <TableColumn fx:id="colEvento" prefWidth="240.0" text="Evento" />
            <TableColumn fx:id="colTotal" prefWidth="150.0" text="Total Pagado" />
            <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
         </columns>
      </TableView>

      <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver" />
   </children>
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>