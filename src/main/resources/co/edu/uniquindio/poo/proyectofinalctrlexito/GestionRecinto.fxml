<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="30.0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.GestionRecintoViewController">

    <padding><Insets bottom="40.0" left="80.0" right="80.0" top="40.0" /></padding>

    <children>

        <!-- Título -->
        <Label text="CONFIGURACIÓN DE RECINTOS Y ESCENARIOS"
               textFill="#000000">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <!-- Separador visual -->
        <Region prefHeight="10.0" />

        <!-- Botón Crear Recinto -->
        <Button fx:id="btnCrearRecinto"
                maxWidth="1.7976931348623157E308"
                prefHeight="50.0"
                mnemonicParsing="false"
                onAction="#abrirCrearRecinto"
                style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Crear Recinto" />

        <!-- Botón Actualizar Recinto -->
        <Button fx:id="btnActualizarRecinto"
                maxWidth="1.7976931348623157E308"
                prefHeight="50.0"
                mnemonicParsing="false"
                onAction="#abrirActualizarRecinto"
                style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Actualizar Recinto" />

        <!-- Botón Eliminar Recinto -->
        <Button fx:id="btnEliminarRecinto"
                maxWidth="1.7976931348623157E308"
                prefHeight="50.0"
                mnemonicParsing="false"
                onAction="#abrirEliminarRecinto"
                style="-fx-background-color: #FFF5F5; -fx-border-color: #FEB2B2; -fx-text-fill: #9B2C2C; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Eliminar Recinto" />

        <!-- Botón Consultar Recinto -->
        <Button fx:id="btnConsultarRecinto"
                maxWidth="1.7976931348623157E308"
                prefHeight="50.0"
                mnemonicParsing="false"
                onAction="#abrirConsultarRecinto"
                style="-fx-background-color: #F7FAFC; -fx-border-color: #CBD5E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Consultar Recinto" />

        <!-- Espaciador -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Botón Volver -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button fx:id="btnVolver"
                        onAction="#volver"
                        prefHeight="38.0"
                        prefWidth="120.0"
                        mnemonicParsing="false"
                        style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="← Volver" />
            </children>
        </HBox>

    </children>
</VBox>
