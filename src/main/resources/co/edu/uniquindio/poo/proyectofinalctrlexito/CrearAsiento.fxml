<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.CrearAsientoViewController">

    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>

    <children>
        <Label text="CREAR ASIENTO" textFill="#2D3748">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="280.0" spacing="12.0"
                      style="-fx-background-color: #F7FAFC; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E2E8F0;">
                    <children>
                        <TextField fx:id="txtFila" prefHeight="35.0" promptText="Fila (Ej: A)" />
                        <TextField fx:id="txtNumero" prefHeight="35.0" promptText="Número (Ej: 12)" />
                        <ComboBox fx:id="cmbZona" maxWidth="1.7976931348623157E308"
                                  prefHeight="35.0" promptText="Seleccionar Zona" />
                        <Button fx:id="btnGuardarAsiento"
                                onAction="#guardarAsiento"
                                maxWidth="1.7976931348623157E308"
                                prefHeight="38.0"
                                style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;"
                                text="Registrar Asiento" />
                    </children>
                </VBox>
                <TableView fx:id="tablaAsientos" style="-fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Button fx:id="btnVolver"
                        onAction="#volver"
                        prefHeight="38.0" prefWidth="120.0"
                        mnemonicParsing="false"
                        style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="← Volver" />
            </children>
        </HBox>
    </children>
</VBox>