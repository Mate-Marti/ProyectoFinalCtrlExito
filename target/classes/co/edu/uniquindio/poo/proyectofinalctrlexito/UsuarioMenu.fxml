<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="750.0" spacing="30.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.UsuarioMenuViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label fx:id="lblTituloUsuarioMenu" text="MENÚ DEL USUARIO" textFill="#2D3748">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label fx:id="lblInfo" text="Acciones rápidas habilitadas para tu cuenta de cliente" textFill="#718096" />
            </children>
        </VBox>
        <HBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER" prefHeight="160.0" prefWidth="200.0" style="-fx-background-color: #EBF8FF; -fx-background-radius: 12; -fx-border-color: #BEE3F8; -fx-border-width: 1.5;">
                    <children>
                        <Label style="-fx-font-size: 32;" />
                        <Button fx:id="btnComprarEntrada" onAction="#abrirCompra" style="-fx-background-color: transparent; -fx-text-fill: #2B6CB0; -fx-font-weight: bold; -fx-cursor: hand;" text="Comprar Entrada" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="160.0" prefWidth="200.0" style="-fx-background-color: #E6FFFA; -fx-background-radius: 12; -fx-border-color: #94E2D5; -fx-border-width: 1.5;">
                    <children>
                        <Label style="-fx-font-size: 32;" />
                        <Button fx:id="btnInfoEvento" onAction="#abrirEvento" style="-fx-background-color: transparent; -fx-text-fill: #234E52; -fx-font-weight: bold; -fx-cursor: hand;" text="Información Eventos" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="160.0" prefWidth="200.0" style="-fx-background-color: #F7FAFC; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1.5;">
                    <children>
                        <Label style="-fx-font-size: 32;" />
                        <Button fx:id="btnGestionPerfil" onAction="#abrirGestionPerfil" style="-fx-background-color: transparent; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-cursor: hand;" text="Gestionar Perfil" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Volver al Inicio" />
    </children>
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>