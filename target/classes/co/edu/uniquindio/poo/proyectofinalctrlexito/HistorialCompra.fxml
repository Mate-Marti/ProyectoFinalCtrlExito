<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.HistorialCompraViewController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="HISTORIAL DE COMPRAS" textFill="#2D3748">
                     <font><Font name="System Bold" size="24.0" /></font>
                  </Label>
                  <Label text="Consulte el registro de todas las transacciones realizadas" textFill="#718096" />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Filtrar por Cliente:" textFill="#4A5568" />
                  <TextField fx:id="txtFiltroUsuario" prefHeight="35.0" prefWidth="250.0" promptText="Cédula o Nombre..." />
                  <Button fx:id="btnBuscar" prefHeight="35.0" style="-fx-background-color: #3182CE; -fx-text-fill: white;" text="Buscar" />
               </children>
            </HBox>
            <TableView fx:id="tablaHistorial" style="-fx-background-radius: 6;" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="btnVolver" onAction="#volver" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 6;" text="Volver" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
