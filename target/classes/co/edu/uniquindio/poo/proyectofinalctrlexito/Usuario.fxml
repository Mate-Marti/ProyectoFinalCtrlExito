<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="500.0" prefWidth="750.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.UsuarioViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label fx:id="lblTitulo" text="LOGIN DE USUARIO" textFill="#304d7b">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
                <Label fx:id="lblInfo" text="Ingresa tus credenciales para acceder a los servicios" textFill="#718096" />
            </children>
            <VBox.margin><Insets bottom="15.0" /></VBox.margin>
        </VBox>
        <VBox prefWidth="320.0" spacing="15.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Nombre de Usuario o Email" textFill="#4A5568" />
                        <TextField fx:id="txtUsuarioCajero" prefHeight="40.0" promptText="NICK del usuario" style="-fx-background-radius: 6; -fx-border-color: #CBD5E0; -fx-border-radius: 6;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Contraseña" textFill="#4A5568" />
                        <PasswordField fx:id="txtContrasenaCajero" prefHeight="40.0" promptText="••••••••" style="-fx-background-radius: 6; -fx-border-color: #CBD5E0; -fx-border-radius: 6;" />
                    </children>
                </VBox>
                <!-- MODIFICADO: agrega onAction -->
                <Button fx:id="btnEntrar" onAction="#iniciarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="42.0" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Iniciar Sesión" />
            </children>
        </VBox>
    </children>
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>