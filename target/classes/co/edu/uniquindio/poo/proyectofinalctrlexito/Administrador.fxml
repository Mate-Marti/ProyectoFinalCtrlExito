<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="500.0" prefWidth="750.0" spacing="20.0" style="-fx-background-color: #F7FAFC;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.AdministradorViewController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label fx:id="lblTitulo" text="INICIO ADMINISTRADOR" textFill="#800020">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label fx:id="lblInfo" text="Acceso restringido solo para personal autorizado" textFill="#718096" />
            </children>
            <VBox.margin><Insets bottom="10.0" /></VBox.margin>
        </VBox>
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Usuario Administrador" textFill="#4A5568" />
                        <TextField fx:id="txtUsuarioCajero" prefHeight="40.0" promptText="Admin ID" style="-fx-background-radius: 6;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Frase de Seguridad" textFill="#4A5568" />
                        <PasswordField fx:id="txtContrasenaCajero" prefHeight="40.0" promptText="••••••••" style="-fx-background-radius: 6;" />
                    </children>
                </VBox>
                <Button fx:id="btnEntrar" onAction="#abrirAdministradorMenu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="42.0" style="-fx-background-color: #800020; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Ingresar al Panel" />
                <Button fx:id="btnVolver" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#volver" prefHeight="40.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" />
            </children>
        </VBox>
    </children>
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>
