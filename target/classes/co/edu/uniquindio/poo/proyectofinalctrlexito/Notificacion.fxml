<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.proyectofinalctrlexito.viewController.NotificacionViewController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="10.0"
              style="-fx-background-color: #F8F9FA; -fx-border-color: #E9ECEF; -fx-border-width: 0 0 1 0;">
            <children>
                <Button onAction="#volverAtras"
                        style="-fx-background-color: #E2E8F0; -fx-text-fill: #4A5568; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="← Volver" />
                <Label text="🔔 NOTIFICACIONES" textFill="#2D3748">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
            </children>
            <padding><Insets left="20.0" right="20.0" /></padding>
        </HBox>
    </top>
    <center>
        <!-- ✅ NUEVO: ScrollPane con VBox donde se cargan los mensajes dinámicamente -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="vboxNotificaciones" spacing="12.0"
                      style="-fx-background-color: #FFFFFF;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
